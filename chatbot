print("🤖 Chatbot: Hello! I am a simple chatbot.")
print("Type 'bye' to end the conversation.\n")

while True:
    user_input = input("You: ").lower()

    if user_input == "hello" or user_input == "hi":
        print("🤖 Chatbot: Hello! How can I help you?")

    elif "how are you" in user_input:
        print("🤖 Chatbot: I'm doing great! Thanks for asking.")

    elif "your name" in user_input:
        print("🤖 Chatbot: My name is RuleBot.")

    elif "help" in user_input:
        print("🤖 Chatbot: I can answer simple questions like greetings, time, date, and my name.")

    elif "time" in user_input:
        from datetime import datetime
        current_time = datetime.now().strftime("%H:%M:%S")
        print(f"🤖 Chatbot: The current time is {current_time}.")

    elif "date" in user_input:
        from datetime import datetime
        current_date = datetime.now().strftime("%Y-%m-%d")
        print(f"🤖 Chatbot: Today's date is {current_date}.")

    elif user_input == "bye":
        print("🤖 Chatbot: Goodbye! Have a nice day.")
        break

    else:
        print("🤖 Chatbot: Sorry, I don't understand that. Please try another question.")
